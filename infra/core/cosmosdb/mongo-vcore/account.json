    "description": "Creates an Azure DocumentDB (Cosmos DB for MongoDB vCore) cluster."
  },
  "parameters": {
    "name": {
      "type": "string"
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]"
    },
    "tags": {
      "type": "object",
      "defaultValue": {}
    },
    "administratorLogin": {
      "type": "securestring",
      "metadata": {
        "description": "Administrator login name."
      }
    },
    "administratorLoginPassword": {
      "type": "securestring",
      "metadata": {
        "description": "Administrator login password."
      }
    },
    "serverVersion": {
      "type": "string",
      "defaultValue": "7.0",
      "metadata": {
        "description": "MongoDB server version."
      }
    },
    "sku": {
      "type": "string",
      "defaultValue": "Free",
      "allowedValues": [
        "Free",
        "M25",
        "M30",
        "M40",
        "M50",
        "M60",
        "M80"
      ],
      "metadata": {
        "description": "The compute tier and size."
      }
    },
    "storageSizeGb": {
      "type": "int",
      "defaultValue": 32,
      "metadata": {
        "description": "Storage size in GB per shard."
      }
    },
    "shardCount": {
      "type": "int",
      "defaultValue": 1,
      "metadata": {
        "description": "Number of shards in the cluster."
      }
    },
    "enableHa": {
      "type": "bool",
      "defaultValue": false,
      "metadata": {
        "description": "Enable high availability. Defaults to false."
      }
    }
  },
  "resources": [
    {
      "type": "Microsoft.DocumentDB/mongoClusters",
      "apiVersion": "2024-07-01",
      "name": "[parameters('name')]",
      "location": "[parameters('location')]",
      "tags": "[parameters('tags')]",
